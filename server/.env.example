# Copy this file to .env and fill it in. Never commit .env or share it.

NODE_ENV=development
PORT=5000

# MongoDB connection string. Local (docker compose up -d) or a hosted cluster such as MongoDB Atlas.
MONGODB_URI=mongodb://127.0.0.1:27017/immaculate_portal

# Signs the session cookie. Must be long and random (32+ characters). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# Encrypts the pupil passwords that the administrator can look up. Another long random value,
# different from SESSION_SECRET. Back it up somewhere safe: if it is lost, the stored copies can no
# longer be read (the administrator can still issue new passwords).
CREDENTIAL_KEY=

# Optional. In production the session cookie is https-only. Set to false ONLY to test a
# production build over plain http on your own computer.
# COOKIE_SECURE=false
